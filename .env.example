# melon_datakit 环境配置
# 复制为 .env 后按需修改

# PostgreSQL 连接串（自备实例，本机安装或远程均可）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datakit

# 服务端口（Elysia：管理 API + mock 流量）
SERVER_PORT=4000

# Web 控制台端口（Next.js）
WEB_PORT=3000

# mock 数据确定性盐值（改它会让所有生成数据变化）
SEED_SALT=datakit-dev-salt

# 请求日志保留天数（超过自动清理）
LOG_RETENTION_DAYS=7

# 新资源首次访问时播种的实体条数
SEED_ENTITIES_COUNT=10
